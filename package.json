{
  "name": "@guillemservera/vue-sortable",
  "version": "0.2.0",
  "description": "Unstyled sortable primitives for Vue 3.",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "license": "MIT",
  "author": "Guillem Servera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillemservera/vue-sortable.git"
  },
  "bugs": {
    "url": "https://github.com/guillemservera/vue-sortable/issues"
  },
  "homepage": "https://github.com/guillemservera/vue-sortable#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/server-renderer": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^25.0.1",
    "publint": "0.3.24",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^2.2.12"
  },
  "keywords": [
    "vue",
    "vue3",
    "sortable",
    "sorting",
    "drag-and-drop",
    "reorder",
    "unstyled",
    "headless",
    "primitive"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:playground": "pnpm --filter @vue-sortable/playground dev",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:ssr": "vitest run tests/ssr.test.ts",
    "test:nuxt": "pnpm build && pnpm --filter @vue-sortable/nuxt-basic generate && node scripts/assert-nuxt-prerender.mjs",
    "test:watch": "vitest",
    "size": "pnpm build && node scripts/check-size.mjs",
    "publint": "publint",
    "pack:dry": "npm pack --dry-run",
    "ci": "pnpm typecheck && pnpm test && pnpm size && pnpm publint && pnpm pack:dry && pnpm test:nuxt",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm size && pnpm publint"
  }
}
